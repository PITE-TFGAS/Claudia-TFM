# --- Dependencias ---
node_modules/
.pnpm-store/

# --- Directorios de Compilación ---
# Donde se genera la extensión lista para cargar/subir
dist/
build/
out/

# --- Archivos de Sistema y Editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Logs y Debugging ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache

# --- Extensiones Específicas ---
# Evita subir el archivo .crx empaquetado manualmente o el archivo de clave privada
*.crx
*.pem

# --- Variables de Entorno ---
# Muy importante si usas APIs secretas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Herramientas de Testing ---
coverage/
.nyc_output/