{
  "manifest_version": 3,
  "name": "Asistente guiado por IA",
  "description": "Guía a los usuarios paso a paso a través de tareas web utilizando asistencia de IA.",
  "version": "0.1.1",

  "permissions": ["activeTab", "scripting", "storage", "tabs", "tts"],
  "host_permissions": ["<all_urls>"],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/domProcessor.js",
        "content/highlighter.js",
        "content/speech.js",
        "content/state.js",     
        "content/tabKeeper.js", 
        "content/sfx.js",
        "content/customAI.js",
        "content/aiCycle.js",     
        "content/inputs.js",   
        "content/content.js",

        "overlay/overlayState.js",
        "overlay/chatUI.js",
        "overlay/chatHandler.js",
        "overlay/overlayDrag.js",
        "overlay/overlayUI.js",
        "overlay/overlay.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "overlay/overlay.html",
        "overlay/overlay.css",
        "overlay/overlay.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
