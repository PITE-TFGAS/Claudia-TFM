{
  "manifest_version": 3,
  "name": "AI Guided Assistant",
  "description": "Guides users step by step through web tasks using AI assistance.",
  "version": "0.0.2",

  "permissions": ["activeTab", "scripting", "storage", "tabs", "tts"],
  "host_permissions": ["<all_urls>"],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/domProcessor.js",
        "content/highlighter.js",
        "content/speech.js",
        "content/state.js",     
        "content/tabKeeper.js", 
        "content/sfx.js",
        "content/customAI.js",
        "content/aiCycle.js",     
        "content/inputs.js",   
        "content/content.js",

        "overlay/overlayState.js",
        "overlay/chatUI.js",
        "overlay/chatHandler.js",
        "overlay/overlayDrag.js",
        "overlay/overlayUI.js",
        "overlay/overlay.js"
      ]
    }
  ],

  "background": {
    "service_worker": "background.js"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "overlay/overlay.html",
        "overlay/overlay.css",
        "overlay/overlay.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
